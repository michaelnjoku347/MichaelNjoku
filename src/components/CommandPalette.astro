---
import Icon, { type IconName } from './Icon.astro';
import { featuredProject, nav, profile } from '../data/site';

type Command = {
  id: string;
  label: string;
  hint: string;
  icon: IconName;
  keywords?: string;
  href?: string;
  external?: boolean;
  action?: 'copy-email' | 'toggle-theme';
};

const sectionIcons: Record<string, IconName> = {
  about: 'user',
  experience: 'briefcase',
  projects: 'layers',
  skills: 'cpu',
  contact: 'mail',
};

const groups: { label: string; items: Command[] }[] = [
  {
    label: 'Kilobyte',
    items: [
      {
        id: 'kilobyte-demo',
        label: 'Play the Kilobyte demo',
        hint: 'Opens in a new tab',
        icon: 'gamepad',
        keywords: 'live demo games play arcade',
        href: featuredProject.links.live,
        external: true,
      },
      {
        id: 'kilobyte-case-study',
        label: 'Read the Kilobyte case study',
        hint: 'Project',
        icon: 'file-text',
        keywords: 'project write-up how it works',
        href: featuredProject.links.caseStudy,
      },
    ],
  },
  {
    label: 'Go to',
    items: [
      { id: 'home', label: 'Home', hint: 'Page', icon: 'home', href: '/' },
      ...nav.map((item) => ({
        id: `section-${item.id}`,
        label: item.label,
        hint: 'Section',
        icon: sectionIcons[item.id] ?? 'arrow-right',
        href: `/#${item.id}`,
      })),
      {
        id: 'education',
        label: 'Education',
        hint: 'Section',
        icon: 'graduation-cap',
        keywords: 'school college farmingdale degree coursework',
        href: '/#education',
      },
      {
        id: 'resume',
        label: 'Résumé',
        hint: 'Printable',
        icon: 'printer',
        keywords: 'resume cv pdf print',
        href: '/resume/',
      },
    ],
  },
  {
    label: 'Actions',
    items: [
      {
        id: 'copy-email',
        label: 'Copy email address',
        hint: profile.email,
        icon: 'copy',
        keywords: 'contact mail clipboard',
        action: 'copy-email',
      },
      {
        id: 'toggle-theme',
        label: 'Switch light / dark theme',
        hint: 'Appearance',
        icon: 'contrast',
        keywords: 'dark mode light mode color',
        action: 'toggle-theme',
      },
    ],
  },
  {
    label: 'Elsewhere',
    items: [
      {
        id: 'github',
        label: 'GitHub',
        hint: `@${profile.links.githubHandle}`,
        icon: 'github',
        keywords: 'code repositories',
        href: profile.links.github,
        external: true,
      },
      {
        id: 'linkedin',
        label: 'LinkedIn',
        hint: 'Profile',
        icon: 'linkedin',
        href: profile.links.linkedin,
        external: true,
      },
      {
        id: 'email',
        label: 'Send an email',
        hint: 'Opens your mail app',
        icon: 'mail',
        keywords: 'contact hire',
        href: `mailto:${profile.email}`,
      },
      {
        id: 'source',
        label: 'View this site’s source',
        hint: 'GitHub',
        icon: 'code',
        keywords: 'repository astro',
        href: profile.links.source,
        external: true,
      },
    ],
  },
];
---

<dialog class="palette" data-palette aria-label="Command menu">
  <div class="palette-panel">
    <div class="palette-search">
      <Icon name="search" size={18} />
      <input
        type="text"
        role="combobox"
        aria-expanded="true"
        aria-controls="palette-list"
        aria-autocomplete="list"
        aria-label="Search commands"
        placeholder="Search pages, projects, and actions…"
        autocomplete="off"
        spellcheck="false"
        data-palette-input
      />
      <button class="palette-esc" type="button" data-palette-close aria-label="Close command menu">Esc</button>
    </div>

    <div class="palette-list" id="palette-list" role="listbox" aria-label="Commands" data-palette-list>
      {
        groups.map((group) => (
          <div class="palette-group" role="group" aria-label={group.label} data-palette-group>
            <div class="palette-group-label" aria-hidden="true">
              {group.label}
            </div>
            {group.items.map((item) => (
              <div
                class="palette-item"
                id={`cmd-${item.id}`}
                role="option"
                aria-selected="false"
                data-palette-item
                data-label={item.label}
                data-keywords={`${item.label} ${item.hint} ${item.keywords ?? ''}`.toLowerCase()}
                data-href={item.href}
                data-external={item.external ? '' : undefined}
                data-action={item.action}
                data-value={item.action === 'copy-email' ? profile.email : undefined}
              >
                <span class="palette-item-icon">
                  <Icon name={item.icon} size={16} />
                </span>
                <span class="palette-item-label">{item.label}</span>
                <span class="palette-item-hint">{item.hint}</span>
                {item.external && <Icon name="arrow-up-right" size={14} class="palette-item-ext" />}
              </div>
            ))}
          </div>
        ))
      }
      <p class="palette-empty" data-palette-empty hidden>No matches. Try “resume”, “Kilobyte”, or “email”.</p>
    </div>

    <div class="palette-foot" aria-hidden="true">
      <span><kbd>↑</kbd><kbd>↓</kbd> move</span>
      <span><kbd>↵</kbd> open</span>
      <span><kbd>esc</kbd> close</span>
    </div>
  </div>
</dialog>

<style>
  .palette {
    width: min(100% - 2rem, 600px);
    max-height: min(560px, 100% - 6rem);
    margin: 12vh auto auto;
    padding: 0;
    border: 1px solid var(--line-2);
    border-radius: 20px;
    background: var(--surface);
    box-shadow: var(--shadow-lg);
    color: var(--text);
    overflow: hidden;
  }

  .palette[open] {
    animation: palette-in 0.28s var(--ease-out);
  }

  .palette::backdrop {
    background: rgb(5 6 8 / 0.55);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  @keyframes palette-in {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
    }
  }

  .palette-panel {
    display: flex;
    flex-direction: column;
    max-height: inherit;
  }

  .palette-search {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0 1rem 0 1.15rem;
    border-bottom: 1px solid var(--line);
    color: var(--text-3);
  }

  .palette-search input {
    flex: 1;
    min-width: 0;
    height: 58px;
    border: 0;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: var(--step-0);
    outline: none;
  }

  .palette-search input::placeholder {
    color: var(--text-3);
  }

  .palette-esc {
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--surface-2);
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    cursor: pointer;
  }

  .palette-list {
    overflow-y: auto;
    padding: 0.5rem;
    overscroll-behavior: contain;
  }

  .palette-group + .palette-group {
    margin-top: 0.35rem;
  }

  .palette-group[hidden] {
    display: none;
  }

  .palette-group-label {
    padding: 0.6rem 0.75rem 0.35rem;
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .palette-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.75rem;
    border-radius: 12px;
    color: var(--text-2);
    cursor: pointer;
    scroll-margin: 0.5rem;
  }

  .palette-item[hidden] {
    display: none;
  }

  .palette-item[aria-selected='true'] {
    background: var(--surface-3);
    color: var(--text);
  }

  .palette-item-icon {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    flex: none;
    border: 1px solid var(--line);
    border-radius: 9px;
    background: var(--surface-2);
  }

  .palette-item[aria-selected='true'] .palette-item-icon {
    border-color: var(--accent-line);
    background: var(--accent-soft);
    color: var(--accent-text);
  }

  .palette-item-label {
    font-weight: 500;
  }

  .palette-item-hint {
    margin-left: auto;
    overflow: hidden;
    color: var(--text-3);
    font-size: var(--step--2);
    font-family: var(--font-mono);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .palette-item :global(.palette-item-ext) {
    flex: none;
    color: var(--text-3);
  }

  .palette-empty {
    padding: 2rem 1rem;
    color: var(--text-3);
    text-align: center;
  }

  .palette-foot {
    display: flex;
    gap: 1.25rem;
    padding: 0.7rem 1.15rem;
    border-top: 1px solid var(--line);
    background: var(--surface-2);
    color: var(--text-3);
    font-size: var(--step--2);
  }

  .palette-foot kbd {
    display: inline-grid;
    place-items: center;
    min-width: 1.5em;
    margin-right: 0.25em;
    padding: 0.05rem 0.3rem;
    border: 1px solid var(--line);
    border-radius: 5px;
    background: var(--surface);
    font-size: 0.68rem;
  }

  @media (max-width: 560px) {
    .palette {
      margin-top: 4.5rem;
    }

    .palette-item-hint,
    .palette-foot {
      display: none;
    }
  }
</style>
