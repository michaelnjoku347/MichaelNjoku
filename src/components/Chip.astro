---
import { chipPins } from '../data/site';

type Pin = {
  label: string;
  number: number;
  side: 'left' | 'right';
  y: number;
  trace: string;
  padY: number;
  labelY: number;
};

const pinY = [125, 195, 265, 335];
const leftTraces = [
  'M162 125 H124 L94 95 H28',
  'M162 195 H28',
  'M162 265 H28',
  'M162 335 H124 L94 365 H28',
];
const rightTraces = [
  'M398 335 H436 L466 365 H532',
  'M398 265 H532',
  'M398 195 H532',
  'M398 125 H436 L466 95 H532',
];
const outerY = (trace: string) => Number(trace.trim().split(' ').at(-2)?.replace(/^[A-Z]/, '') ?? 0);

// DIP numbering: pins 1–4 run down the left side, 5–8 run back up the right.
const pins: Pin[] = chipPins.map((label, index) => {
  const left = index < 4;
  const trace = left ? leftTraces[index] : rightTraces[index - 4];
  const y = left ? pinY[index] : pinY[7 - index];
  const outer = outerY(trace);
  return {
    label: label.toUpperCase(),
    number: index + 1,
    side: left ? 'left' : 'right',
    y,
    trace,
    padY: outer,
    labelY: outer > 340 ? outer + 24 : outer - 13,
  };
});

const description = `Illustration of a microchip marked “MN” on a circuit board. Its eight pins are labeled ${chipPins.join(', ')}.`;
---

<div class="board" data-tilt>
  <svg class="board-svg" viewBox="0 0 560 460" role="img" aria-label={description}>
    <defs>
      <linearGradient id="chip-sheen" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#2a2d33" />
        <stop offset="0.45" stop-color="#16181c" />
        <stop offset="1" stop-color="#0d0e10" />
      </linearGradient>
      <linearGradient id="leg-metal" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#e7e9ed" />
        <stop offset="0.5" stop-color="#a7acb5" />
        <stop offset="1" stop-color="#6f747d" />
      </linearGradient>
      <radialGradient id="led-glow">
        <stop offset="0" stop-color="#7dffb6" stop-opacity="0.9" />
        <stop offset="1" stop-color="#3ee089" stop-opacity="0" />
      </radialGradient>
    </defs>

    <g class="board-holes">
      {
        [
          [26, 26],
          [534, 26],
          [26, 434],
          [534, 434],
        ].map(([cx, cy]) => (
          <g>
            <circle cx={cx} cy={cy} r="10" class="hole-ring" />
            <circle cx={cx} cy={cy} r="5" class="hole" />
          </g>
        ))
      }
    </g>

    <g class="silk">
      <text x="196" y="56">U1</text>
      <text x="280" y="438" text-anchor="middle" class="silk-dim">NJOKU.DEV · REV 2.0</text>
      <text x="436" y="49" class="silk-dim">PWR</text>
      <path d="M190 62 V70 M190 62 H198" class="silk-line" />
    </g>

    <g class="vias">
      <circle cx="122" cy="230" r="4" />
      <circle cx="438" cy="230" r="4" />
      <circle cx="80" cy="230" r="4" />
      <circle cx="480" cy="230" r="4" />
    </g>

    <g class="led-group">
      <circle cx="418" cy="44" r="18" fill="url(#led-glow)" class="led-halo" />
      <rect x="411" y="40" width="14" height="8" rx="2" class="led-body" />
    </g>

    <g class="traces">
      {pins.map((pin) => <path d={pin.trace} class="trace" />)}
    </g>

    <g class="pulses">
      {
        pins.map((pin, i) => (
          <path d={pin.trace} class="pulse" pathLength="100" style={`--i: ${(i * 3) % 8}`} />
        ))
      }
    </g>

    <g class="pads">
      {
        pins.map((pin) => {
          const x = pin.side === 'left' ? 28 : 532;
          return (
            <g>
              <circle cx={x} cy={pin.padY} r="7" class="pad" />
              <circle cx={x} cy={pin.padY} r="2.6" class="pad-hole" />
            </g>
          );
        })
      }
    </g>

    <g class="labels">
      {
        pins.map((pin) => (
          <text
            x={pin.side === 'left' ? 46 : 514}
            y={pin.labelY}
            text-anchor={pin.side === 'left' ? 'start' : 'end'}
          >
            {pin.label}
          </text>
        ))
      }
    </g>

    <g class="legs">
      {
        pins.map((pin) => (
          <rect x={pin.side === 'left' ? 160 : 370} y={pin.y - 8} width="30" height="16" rx="3" fill="url(#leg-metal)" />
        ))
      }
    </g>

    <g class="chip">
      <path
        class="chip-body"
        d="M204 70 H262 A18 18 0 0 0 298 70 H356 Q370 70 370 84 V376 Q370 390 356 390 H204 Q190 390 190 376 V84 Q190 70 204 70 Z"
        fill="url(#chip-sheen)"
      />
      <circle cx="214" cy="96" r="7" class="chip-dimple" />
      <text x="280" y="226" text-anchor="middle" class="chip-mark">MN</text>
      <text x="280" y="262" text-anchor="middle" class="chip-code">CS · 2029</text>
      <text x="280" y="352" text-anchor="middle" class="chip-sub">NJOKU.DEV</text>
      <text x="280" y="370" text-anchor="middle" class="chip-sub chip-sub-dim">FREEPORT NY</text>
    </g>
  </svg>
</div>

<style>
  .board {
    --rx: 0deg;
    --ry: 0deg;
    position: relative;
    border: 1px solid var(--pcb-edge);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(120% 90% at 30% 0%, var(--pcb-bg-hi), transparent 60%),
      radial-gradient(circle, var(--pcb-dot) 1.2px, transparent 1.4px) 0 0 / 18px 18px,
      var(--pcb-bg);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.06),
      inset 0 0 0 1px rgb(0 0 0 / 0.4),
      var(--shadow-lg);
    transform: perspective(1200px) rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform 0.6s var(--ease-out);
    will-change: transform;
  }

  .board::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(130deg, rgb(255 255 255 / 0.06), transparent 40%);
    pointer-events: none;
  }

  .board-svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .hole-ring {
    fill: none;
    stroke: var(--pcb-pad);
    stroke-width: 3;
    opacity: 0.65;
  }

  .hole,
  .pad-hole {
    fill: #030604;
  }

  .silk text {
    fill: var(--pcb-silk);
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.12em;
  }

  .silk .silk-dim {
    fill: var(--pcb-silk-dim);
    font-size: 11px;
  }

  .silk-line {
    fill: none;
    stroke: var(--pcb-silk);
    stroke-width: 1.5;
  }

  .vias circle {
    fill: #030604;
    stroke: var(--pcb-trace);
    stroke-width: 2.5;
  }

  .led-body {
    fill: #46f59a;
  }

  .led-halo {
    animation: breathe 3.2s ease-in-out infinite;
  }

  @keyframes breathe {
    50% {
      opacity: 0.35;
    }
  }

  .trace {
    fill: none;
    stroke: var(--pcb-trace);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: stroke 0.4s;
  }

  .board:hover .trace {
    stroke: color-mix(in srgb, var(--pcb-trace) 70%, var(--pcb-trace-hi));
  }

  .pulse {
    fill: none;
    stroke: var(--pulse);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-dasharray: 9 130;
    stroke-dashoffset: -100;
    filter: drop-shadow(0 0 5px rgb(255 205 110 / 0.85));
    animation: pulse-in 4.8s var(--ease-in-out) infinite;
    animation-delay: calc(var(--i) * -0.6s);
  }

  /* Signals travel from each pad into the chip, then rest. */
  @keyframes pulse-in {
    0% {
      stroke-dashoffset: -100;
    }
    55%,
    100% {
      stroke-dashoffset: 9;
    }
  }

  .pad {
    fill: var(--pcb-pad);
  }

  .labels text {
    fill: var(--pcb-silk);
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .chip-body {
    stroke: var(--ic-edge);
    stroke-width: 2;
  }

  .chip-dimple {
    fill: #0a0b0d;
    stroke: #2b2e34;
    stroke-width: 1.5;
  }

  .chip-mark {
    fill: rgb(230 233 238 / 0.92);
    font-family: var(--font-display);
    font-size: 84px;
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  .chip-code {
    fill: var(--accent);
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.28em;
  }

  .chip-sub {
    fill: rgb(230 233 238 / 0.55);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.24em;
  }

  .chip-sub-dim {
    fill: rgb(230 233 238 / 0.3);
  }

  @media (prefers-reduced-motion: reduce) {
    .pulse {
      display: none;
    }

    .board {
      transform: none;
    }
  }
</style>
