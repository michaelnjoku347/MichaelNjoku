---
import Icon from './Icon.astro';
import { profile } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <p class="footer-motto">“{profile.motto}”</p>
      <p class="footer-note">Built byte by byte by {profile.name}.</p>
    </div>
    <ul class="footer-links">
      <li>
        <a href={profile.links.github} rel="me noopener" target="_blank">
          <Icon name="github" size={16} /> GitHub
        </a>
      </li>
      <li>
        <a href={profile.links.linkedin} rel="me noopener" target="_blank">
          <Icon name="linkedin" size={16} /> LinkedIn
        </a>
      </li>
      <li>
        <a href="/#contact">
          <Icon name="message" size={16} /> Contact
        </a>
      </li>
    </ul>
    <p class="footer-meta">
      <span>© {year} {profile.name}</span>
      <span aria-hidden="true">·</span>
      <span>Made with Astro, hosted on Vercel</span>
      <span aria-hidden="true">·</span>
      <a href={profile.links.source} target="_blank" rel="noopener">View source</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: 3rem 2.5rem;
    background: var(--bg-2);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1.5rem 2rem;
    align-items: center;
  }

  .footer-motto {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .footer-note {
    margin-top: 0.35rem;
    color: var(--text-3);
    font-size: var(--step--1);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
  }

  .footer-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--text-2);
    font-size: var(--step--1);
    text-decoration: none;
    transition:
      color 0.2s,
      border-color 0.2s;
  }

  .footer-links a:hover {
    color: var(--text);
    border-color: var(--line-2);
  }

  .footer-meta {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: 1.5rem;
    border-top: 1px dashed var(--line);
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--step--2);
  }

  .footer-meta a {
    color: var(--text-2);
  }

  @media (max-width: 720px) {
    .footer-inner {
      grid-template-columns: 1fr;
    }
  }
</style>
