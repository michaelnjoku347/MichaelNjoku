---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import photo from '../assets/michael.jpg';
---

<BaseLayout title="Page not found" description="This page doesn’t exist on njoku.dev." noindex>
  <section class="container lost">
    <div class="lost-art" aria-hidden="true">
      <span>4</span>
      <Image src={photo} alt="" widths={[120, 240]} sizes="120px" />
      <span>4</span>
    </div>
    <p class="eyebrow">Error 404</p>
    <h1>This page doesn’t exist.</h1>
    <p class="section-lede">It may have moved, or the link might have a typo. Here are a few places to go instead.</p>
    <div class="lost-actions">
      <a class="btn btn-primary" href="/"><Icon name="home" />Back home</a>
      <a class="btn" href="/projects/"><Icon name="layers" />See my projects</a>
      <button class="btn btn-ghost" type="button" data-palette-open><Icon name="search" />Search the site</button>
    </div>
  </section>
</BaseLayout>

<style>
  .lost {
    display: grid;
    justify-items: center;
    gap: 1.1rem;
    padding-block: clamp(4rem, 12vw, 8rem);
    text-align: center;
  }

  .lost-art {
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 2vw, 1rem);
    margin-bottom: 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(6rem, 4rem + 9vw, 10rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.06em;
  }

  .lost-art span {
    background: linear-gradient(160deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .lost-art :global(img) {
    width: 0.78em;
    height: 0.78em;
    border: 0.04em solid var(--accent);
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 20px 40px -18px var(--accent);
  }

  .lost h1 {
    max-width: 16ch;
    font-size: var(--step-4);
    letter-spacing: -0.04em;
  }

  .lost .section-lede {
    max-width: 34rem;
  }

  .lost-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1rem;
  }
</style>
