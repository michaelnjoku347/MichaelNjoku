---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import FeaturedProject from '../components/FeaturedProject.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import SectionHeading from '../components/SectionHeading.astro';
import photo from '../assets/michael.jpg';
import { askMeAbout, contactForm, education, experience, interests, profile, skills } from '../data/site';
import { getProjects } from '../lib/projects';

const projects = await getProjects();
const featured = projects.filter((project) => project.data.featured);
const others = projects.filter((project) => !project.data.featured);

const current = experience.find((job) => job.current);
const start = Date.parse(education.started);
const end = Date.parse(education.graduates);
const progress = Math.min(100, Math.max(0, ((Date.now() - start) / (end - start)) * 100));
const classOf = education.graduates.slice(0, 4);

const interestIcons: IconName[] = ['cpu', 'zap', 'users'];
const hasForm = Boolean(contactForm.accessKey.trim());
const askSubject = (topic: string) =>
  `Asking about ${topic.replace(/^My\b/, 'your').replace(/^Whatever/, 'whatever')}`;
const when = (job: (typeof experience)[number]) => (job.start === job.end ? job.start : `${job.start} – ${job.end}`);
const photoAlt = `${profile.name}, smiling, in a navy suit and tie`;
---

<BaseLayout>
  <section class="hero" id="top" aria-labelledby="hero-title">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <Image class="hero-avatar" src={photo} alt={photoAlt} widths={[80, 160]} sizes="80px" loading="eager" />
        <p class="hero-kicker" data-reveal>Hi, I’m</p>
        <h1 id="hero-title" data-reveal style="--reveal-delay: 1">{profile.name}</h1>
        <p class="hero-role" data-reveal style="--reveal-delay: 2">{profile.title}</p>
        <p class="hero-lede" data-reveal style="--reveal-delay: 3">{profile.intro}</p>
        <div class="hero-ctas" data-reveal style="--reveal-delay: 4">
          <a class="btn btn-primary btn-lg" href="#projects">
            See my projects
            <Icon name="arrow-down" />
          </a>
          <a class="btn btn-lg" href="#contact">
            <Icon name="message" />
            Get in touch
          </a>
        </div>
      </div>

      <aside class="profile" aria-label="At a glance" data-tilt-area data-reveal style="--reveal-delay: 2">
        <div class="profile-card" data-tilt>
          <div class="profile-photo">
            <Image src={photo} alt={photoAlt} widths={[176, 300]} sizes="176px" loading="eager" fetchpriority="high" />
            <span class="profile-dot" aria-hidden="true"></span>
          </div>
          <p class="status-pill">
            <span class="led" aria-hidden="true"></span>
            {profile.status}
          </p>
          <dl class="profile-facts">
            {
              current && (
                <div>
                  <dt>
                    <Icon name="briefcase" size={16} />
                    Now
                  </dt>
                  <dd>
                    {current.role} at {current.company}
                  </dd>
                </div>
              )
            }
            <div>
              <dt><Icon name="graduation-cap" size={16} />Studying</dt>
              <dd>{education.shortDegree}, {education.school} ’{classOf.slice(2)}</dd>
            </div>
            <div>
              <dt><Icon name="map-pin" size={16} />Based in</dt>
              <dd>
                {profile.location}
                <span class="profile-time" data-clock={profile.timeZone}></span>
              </dd>
            </div>
          </dl>
          <ul class="profile-links">
            <li>
              <a class="btn btn-small" href={profile.links.github} target="_blank" rel="me noopener">
                <Icon name="github" />GitHub
              </a>
            </li>
            <li>
              <a class="btn btn-small" href={profile.links.linkedin} target="_blank" rel="me noopener">
                <Icon name="linkedin" />LinkedIn
              </a>
            </li>
            <li>
              <a class="btn btn-small" href="/resume/"><Icon name="file-text" />Résumé</a>
            </li>
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section-projects" id="projects" aria-labelledby="projects-title">
    <div class="container">
      <div class="section-top">
        <SectionHeading
          id="projects-title"
          index="01"
          label="Projects"
          lede="A growing collection of things I’ve made. Click Kilobyte to play the live demo right in your browser."
        >
          Things I’ve built.
        </SectionHeading>
        <a class="see-all" href="/projects/" data-reveal>
          All projects <span class="see-all-count">{projects.length}</span>
          <Icon name="arrow-right" size={16} />
        </a>
      </div>

      {featured.map((project) => <FeaturedProject project={project} />)}
      <ProjectGrid projects={others.slice(0, 5)} />
    </div>
  </section>

  <section class="section" id="about" aria-labelledby="about-title">
    <div class="container">
      <SectionHeading id="about-title" index="02" label="About">A bit about me.</SectionHeading>
      <div class="about-grid">
        <div class="about-copy" data-reveal>
          {profile.about.map((paragraph) => <p>{paragraph}</p>)}
          <ul class="interests">
            {
              interests.map((interest, i) => (
                <li>
                  <span class="interest-icon">
                    <Icon name={interestIcons[i] ?? 'zap'} size={17} />
                  </span>
                  {interest}
                </li>
              ))
            }
          </ul>
        </div>

        <dl class="facts" data-reveal style="--reveal-delay: 2">
          <div class="fact card">
            <dt>Class of</dt>
            <dd>{classOf}</dd>
          </div>
          <div class="fact card">
            <dt>Speaks</dt>
            <dd>English · Spanish</dd>
          </div>
          <div class="fact card fact-wide">
            <dt>On campus</dt>
            <dd>
              {education.clubs.join(' · ')}
              <span>{education.school}</span>
            </dd>
          </div>
          <div class="fact card fact-wide fact-motto">
            <dt>Favorite phrase</dt>
            <dd>“{profile.motto}”</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="section" id="experience" aria-labelledby="experience-title">
    <div class="container">
      <SectionHeading
        id="experience-title"
        index="03"
        label="Experience"
        lede="Startups, retail, and team leadership: each one taught me how to communicate, adapt fast, and get things done with people."
      >
        Where I’ve worked.
      </SectionHeading>

      <ol class="timeline">
        {
          experience.map((job) => (
            <li class="job" data-reveal>
              <div class="job-rail" aria-hidden="true">
                <span class:list={['job-dot', { 'is-current': job.current }]} />
              </div>
              <article class="job-card card spotlight">
                <header class="job-head">
                  <div>
                    <h3>
                      {job.role} <span class="job-at">· {job.company}</span>
                    </h3>
                    <p class="job-summary">{job.summary}</p>
                  </div>
                  <p class="job-when mono">
                    {when(job)}
                    <span>{job.location}</span>
                  </p>
                </header>
                {job.current && (
                  <p class="job-now">
                    <span class="led" aria-hidden="true" />
                    Current role
                  </p>
                )}
                <ul class="job-points">
                  {job.highlights.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
              </article>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" id="skills" aria-labelledby="skills-title">
    <div class="container">
      <SectionHeading
        id="skills-title"
        index="04"
        label="Skills"
        lede="The languages and tools I use, the systems I troubleshoot, and the people skills that hold a team together."
      >
        What I work with.
      </SectionHeading>
      <div class="skills-grid">
        {
          skills.map((group, i) => (
            <article class="skill card spotlight" data-reveal style={`--reveal-delay: ${i % 3}`}>
              <div class="skill-head">
                <span class="skill-icon">
                  <Icon name={group.icon} size={18} />
                </span>
                <h3>{group.title}</h3>
              </div>
              <ul class="tags">
                {group.items.map((item) => (
                  <li class="tag">{item}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="education" aria-labelledby="education-title">
    <div class="container">
      <SectionHeading id="education-title" index="05" label="Education">Where I’m studying.</SectionHeading>
      <div class="edu-grid">
        <article class="edu card" data-reveal>
          <div class="edu-head">
            <span class="edu-icon"><Icon name="graduation-cap" size={22} /></span>
            <div>
              <h3>{education.school}</h3>
              <p>{education.degree}</p>
            </div>
          </div>
          <p class="edu-when mono">{education.location} · {education.graduationLabel}</p>
          <div class="terminal">
            <p><span class="prompt">~/fsc $</span> make bs-computer-science</p>
            <div
              class="progress"
              role="progressbar"
              aria-label="Degree progress"
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow={progress.toFixed(0)}
              data-progress
              data-start={education.started}
              data-end={education.graduates}
              style={`--progress: ${progress}%`}
            >
              <span></span>
            </div>
            <p class="terminal-dim">
              <span data-progress-label>{progress.toFixed(1)}%</span> compiled · target: May {classOf}
            </p>
          </div>
        </article>

        <article class="card coursework" data-reveal style="--reveal-delay: 1">
          <h3>Relevant coursework</h3>
          <ul class="course-list">
            {
              education.coursework.map((course) => (
                <li>
                  <Icon name="check" size={16} />
                  {course}
                </li>
              ))
            }
          </ul>
          <h3>Clubs</h3>
          <ul class="tags">
            {education.clubs.map((club) => <li class="tag">{club}</li>)}
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="section contact" id="contact" aria-labelledby="contact-title">
    <div class="container">
      <div class="contact-card" data-reveal>
        <div class="contact-bg" aria-hidden="true"></div>
        <div class="contact-intro">
          <p class="eyebrow"><span class="eyebrow-index">06</span>Contact</p>
          <h2 id="contact-title">Let’s build something <span class="gradient-text">together</span>.</h2>
          <p class="section-lede">
            I’m open to internships and entry-level roles, and always happy to talk code, projects, or startups.
          </p>
          <div class="contact-links">
            <a class="btn" href={profile.links.linkedin} target="_blank" rel="me noopener">
              <Icon name="linkedin" />
              LinkedIn
            </a>
            <a class="btn" href={profile.links.github} target="_blank" rel="me noopener">
              <Icon name="github" />
              GitHub
            </a>
          </div>
          <div class="ask">
            <p class="ask-title mono">Ask me about</p>
            <ul class="ask-list">
              {
                askMeAbout.map((topic) => (
                  <li>
                    {hasForm ? (
                      <button type="button" data-topic={askSubject(topic)}>
                        {topic}
                      </button>
                    ) : (
                      <span>{topic}</span>
                    )}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
        <ContactForm />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */

  .hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(2.5rem, 7vw, 5.5rem) clamp(1rem, 3vw, 2rem);
  }

  .hero-bg {
    position: absolute;
    inset: calc(-1 * var(--header-h)) 0 0;
    background:
      radial-gradient(34rem 26rem at 76% 40%, var(--glow), transparent 70%),
      radial-gradient(circle, var(--dot) 1px, transparent 1.3px) 0 0 / 22px 22px;
    -webkit-mask-image: radial-gradient(ellipse 85% 75% at 55% 35%, #000 35%, transparent 80%);
    mask-image: radial-gradient(ellipse 85% 75% at 55% 35%, #000 35%, transparent 80%);
    pointer-events: none;
    z-index: -1;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }

  .hero-copy :global(.hero-avatar) {
    display: none;
  }

  .hero-kicker {
    color: var(--accent-text);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .hero h1 {
    margin-top: 0.35rem;
    font-size: clamp(3rem, 1.9rem + 5.4vw, 6.25rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  .hero-role {
    margin-top: 1rem;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-lede {
    max-width: 36rem;
    margin-top: 1.25rem;
    color: var(--text-2);
    font-size: var(--step-1);
    line-height: 1.6;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  /* ---------- Profile card ---------- */

  .profile {
    display: flex;
    justify-content: center;
  }

  .profile-card {
    --rx: 0deg;
    --ry: 0deg;
    position: relative;
    display: grid;
    justify-items: center;
    width: min(100%, 25rem);
    padding: 2rem clamp(1.25rem, 3vw, 1.75rem) 1.6rem;
    border: 1px solid var(--line-2);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(22rem 14rem at 50% 0%, var(--accent-soft), transparent 70%),
      var(--surface);
    box-shadow: var(--shadow-lg);
    transform: perspective(1200px) rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform 0.6s var(--ease-out);
  }

  .profile-photo {
    position: relative;
    width: 176px;
    aspect-ratio: 1;
    padding: 5px;
    border-radius: 50%;
    background: conic-gradient(from 210deg, var(--accent), var(--accent-2), var(--accent));
    box-shadow: 0 18px 40px -18px var(--accent);
  }

  .profile-photo :global(img) {
    width: 100%;
    height: 100%;
    border: 4px solid var(--surface);
    border-radius: 50%;
    object-fit: cover;
  }

  .profile-dot {
    position: absolute;
    right: 14px;
    bottom: 14px;
    width: 22px;
    height: 22px;
    border: 4px solid var(--surface);
    border-radius: 50%;
    background: var(--led);
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.4rem;
    padding: 0.4rem 0.85rem 0.4rem 0.75rem;
    border: 1px solid color-mix(in srgb, var(--led) 35%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--led) 9%, transparent);
    color: var(--text);
    font-size: var(--step--1);
    font-weight: 500;
    text-align: left;
  }

  .profile-facts {
    display: grid;
    width: 100%;
    margin: 1.4rem 0 0;
    border-top: 1px solid var(--line);
  }

  .profile-facts > div {
    display: grid;
    grid-template-columns: 7.25rem minmax(0, 1fr);
    gap: 0.75rem;
    padding: 0.75rem 0.15rem;
    border-bottom: 1px solid var(--line);
  }

  .profile-facts dt {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    align-self: start;
    color: var(--text-3);
    font-size: var(--step--1);
    line-height: 1.5;
  }

  .profile-facts dd {
    margin: 0;
    font-size: var(--step--1);
    font-weight: 600;
    line-height: 1.5;
  }

  .profile-time:not(:empty)::before {
    content: ' · ';
    color: var(--text-3);
    font-weight: 400;
  }

  .profile-time {
    color: var(--text-2);
    font-weight: 500;
  }

  .profile-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.35rem;
    list-style: none;
  }

  /* ---------- Projects ---------- */

  .section-projects {
    padding-top: clamp(3rem, 6vw, 4.5rem);
  }

  .section-top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0 2rem;
  }

  .see-all {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: clamp(2.25rem, 5vw, 3.5rem);
    padding: 0.6rem 0.75rem 0.6rem 1.1rem;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    background: var(--surface);
    font-size: var(--step--1);
    font-weight: 600;
    text-decoration: none;
    transition:
      border-color 0.2s,
      color 0.2s;
  }

  .see-all:hover {
    border-color: var(--accent-line);
    color: var(--accent-text);
  }

  .see-all-count {
    display: inline-grid;
    place-items: center;
    min-width: 1.6rem;
    height: 1.6rem;
    padding: 0 0.4rem;
    border-radius: 999px;
    background: var(--surface-3);
    color: var(--text-2);
    font-family: var(--font-mono);
    font-size: var(--step--2);
  }

  /* ---------- About ---------- */

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .about-copy p {
    color: var(--text-2);
    font-size: var(--step-1);
    line-height: 1.7;
  }

  .about-copy p:first-child {
    color: var(--text);
  }

  .about-copy p + p {
    margin-top: 1.1rem;
  }

  .interests {
    display: grid;
    gap: 0.85rem;
    margin-top: 2rem;
    padding-top: 1.75rem;
    border-top: 1px dashed var(--line-2);
    list-style: none;
  }

  .interests li {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    color: var(--text-2);
  }

  .interest-icon,
  .skill-icon,
  .edu-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 38px;
    height: 38px;
    border: 1px solid var(--accent-line);
    border-radius: 11px;
    background: var(--accent-soft);
    color: var(--accent-text);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
    margin: 0;
  }

  .fact {
    padding: 1.15rem 1.3rem 1.25rem;
    border-radius: var(--radius);
  }

  .fact-wide {
    grid-column: 1 / -1;
  }

  .fact dt {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .fact dd {
    margin: 0.45rem 0 0;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .fact dd span {
    display: block;
    margin-top: 0.2rem;
    color: var(--text-2);
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 400;
    letter-spacing: 0;
  }

  .fact-motto {
    border-color: var(--accent-line);
    background:
      radial-gradient(30rem 10rem at 100% 0%, var(--accent-soft), transparent 70%),
      var(--surface);
  }

  .fact-motto dd {
    font-size: var(--step-2);
  }

  /* ---------- Experience ---------- */

  .timeline {
    display: grid;
    gap: 1.25rem;
    list-style: none;
  }

  .job {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    gap: clamp(0.75rem, 2vw, 1.5rem);
  }

  .job-rail {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .job-rail::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: -1.25rem;
    width: 2px;
    background: var(--line-2);
  }

  .job:first-child .job-rail::before {
    top: 2.2rem;
    background: linear-gradient(var(--accent-line), var(--line-2));
  }

  .job:last-child .job-rail::before {
    bottom: auto;
    height: 2.2rem;
  }

  .job-dot {
    position: relative;
    width: 16px;
    height: 16px;
    margin-top: 1.7rem;
    border: 3px solid var(--text-3);
    border-radius: 50%;
    background: var(--bg);
  }

  .job-dot.is-current {
    border-color: var(--led);
    box-shadow:
      0 0 0 5px color-mix(in srgb, var(--led) 16%, transparent),
      0 0 22px var(--led-glow);
  }

  .job-card {
    padding: clamp(1.25rem, 3vw, 1.85rem);
  }

  .job-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.6rem 2rem;
  }

  .job-head h3 {
    font-size: var(--step-2);
  }

  .job-at {
    color: var(--accent-text);
  }

  .job-summary {
    margin-top: 0.4rem;
    color: var(--text-2);
  }

  .job-when {
    color: var(--text-2);
    font-size: var(--step--1);
    text-align: right;
  }

  .job-when span {
    display: block;
    color: var(--text-3);
  }

  .job-now {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 1rem;
    padding: 0.28rem 0.75rem;
    border: 1px solid color-mix(in srgb, var(--led) 40%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--led) 9%, transparent);
    color: var(--led);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .job-points {
    display: grid;
    gap: 0.6rem;
    margin-top: 1.2rem;
    list-style: none;
  }

  .job-points li {
    position: relative;
    padding-left: 1.5rem;
