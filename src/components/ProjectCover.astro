---
// A generated cover for projects without a screenshot. The colors are picked
// from the title, so each project keeps the same look on every build.
interface Props {
  title: string;
  tags?: string[];
  class?: string;
}

const { title, tags = [], class: className } = Astro.props;

const palettes = [
  ['#ffb224', '#ff5f1f'],
  ['#8b5cf6', '#ec4899'],
  ['#14b8a6', '#3b82f6'],
  ['#22c55e', '#a3e635'],
  ['#f43f5e', '#f59e0b'],
  ['#38bdf8', '#6366f1'],
];
const hash = [...title].reduce((sum, char) => (sum * 31 + char.charCodeAt(0)) >>> 0, 7);
const [from, to] = palettes[hash % palettes.length];
---

<div class:list={['cover', className]} style={`--from: ${from}; --to: ${to}`} aria-hidden="true">
  <span class="cover-letter">{title.trim().charAt(0)}</span>
  <span class="cover-title">{title}</span>
  {tags.length > 0 && <span class="cover-tags">{tags.slice(0, 3).join(' · ')}</span>}
</div>

<style>
  .cover {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.5em;
    aspect-ratio: 16 / 10;
    padding: 7% 7.5%;
    overflow: hidden;
    isolation: isolate;
    container-type: inline-size;
    background:
      radial-gradient(120% 95% at 0% 0%, color-mix(in srgb, var(--from) 72%, transparent), transparent 62%),
      radial-gradient(100% 90% at 100% 100%, color-mix(in srgb, var(--to) 70%, transparent), transparent 60%),
      #0f1115;
    color: #fff;
  }

  .cover::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(circle, rgb(255 255 255 / 0.12) 1px, transparent 1.3px) 0 0 / 18px 18px;
    -webkit-mask-image: linear-gradient(160deg, #000, transparent 75%);
    mask-image: linear-gradient(160deg, #000, transparent 75%);
  }

  .cover-letter {
    position: absolute;
    top: -0.22em;
    right: -0.04em;
    z-index: -1;
    color: rgb(255 255 255 / 0.1);
    font-family: var(--font-display);
    font-size: 78cqi;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.06em;
  }

  .cover-title {
    display: -webkit-box;
    max-width: 16ch;
    overflow: hidden;
    font-family: var(--font-display);
    font-size: max(1.4rem, 10.5cqi);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.035em;
    text-wrap: balance;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
  }

  .cover-tags {
    color: rgb(255 255 255 / 0.72);
    font-family: var(--font-mono);
    font-size: max(0.7rem, 3.4cqi);
    letter-spacing: 0.04em;
  }
</style>
