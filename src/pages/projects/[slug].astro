---
// One page per project that has text below its frontmatter. Kilobyte has its
// own hand-built page (src/pages/projects/kilobyte.astro), so it's skipped here.
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrowserFrame from '../../components/BrowserFrame.astro';
import Icon from '../../components/Icon.astro';
import ProjectCover from '../../components/ProjectCover.astro';
import { profile } from '../../data/site';
import { demoAddress, getProjects, isThisSite, type Project } from '../../lib/projects';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  const pages = projects.filter((project) => !project.data.caseStudy && Boolean(project.body?.trim()));
  return pages.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: pages[(i + 1) % pages.length] },
  }));
}) satisfies GetStaticPaths;

interface Props {
  project: Project;
  next: Project;
}

const { project, next } = Astro.props;
const { title, summary, year, type, tags, cover, coverAlt, demo, demoLabel, repo, draft } = project.data;
const { Content } = await render(project);
const liveDemo = demo && !isThisSite(project) ? demo : undefined;
---

<BaseLayout title={title} description={`${summary} A project by ${profile.name}.`} noindex={draft}>
  <article>
    <header class="page-hero">
      <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/projects/"><Icon name="arrow-left" size={16} />All projects</a>
        </nav>
        <p class="eyebrow" data-reveal>
          {type} · {year}{draft && ' · Draft'}
        </p>
        <h1 data-reveal style="--reveal-delay: 1">{title}</h1>
        <p class="section-lede" data-reveal style="--reveal-delay: 2">{summary}</p>
        <div class="project-actions" data-reveal style="--reveal-delay: 3">
          {
            liveDemo && (
              <a class="btn btn-primary btn-lg" href={liveDemo} target="_blank" rel="noopener">
                <Icon name="play" />
                {demoLabel ?? 'Open the live demo'}
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
            )
          }
          {
            isThisSite(project) && (
              <span class="live-badge">
                <span class="led" aria-hidden="true" />
                You’re looking at it
              </span>
            )
          }
          {
            repo && (
              <a class="btn btn-lg" href={repo} target="_blank" rel="noopener">
                <Icon name="github" />
                View the code
              </a>
            )
          }
        </div>
      </div>
    </header>

    <div class="container project-layout">
      <figure class="project-figure" data-reveal>
        {
          cover ? (
            <BrowserFrame address={demoAddress(demo ?? `/projects/${project.id}/`)}>
              <Image
                src={cover}
                alt={coverAlt ?? ''}
                widths={[720, 1080, 1440]}
                sizes="(min-width: 1180px) 1160px, 100vw"
                loading="eager"
              />
            </BrowserFrame>
          ) : (
            <ProjectCover title={title} tags={tags} class="project-figure-cover" />
          )
        }
      </figure>

      <div class="project-columns">
        <div class="prose" data-reveal>
          <Content />
        </div>

        <aside class="project-facts card" aria-label="Project details" data-reveal style="--reveal-delay: 1">
          <dl>
            <div>
              <dt>Year</dt>
              <dd>{year}</dd>
            </div>
            <div>
              <dt>Type</dt>
              <dd>{type}</dd>
            </div>
            {
              tags.length > 0 && (
                <div>
                  <dt>Built with</dt>
                  <dd>
                    <ul class="tags">
                      {tags.map((tag) => (
                        <li class="tag">{tag}</li>
                      ))}
                    </ul>
                  </dd>
                </div>
              )
            }
            {
              (liveDemo || repo) && (
                <div>
                  <dt>Links</dt>
                  <dd class="project-links">
                    {liveDemo && (
                      <a href={liveDemo} target="_blank" rel="noopener">
                        Live demo <Icon name="arrow-up-right" size={15} />
                      </a>
                    )}
                    {repo && (
                      <a href={repo} target="_blank" rel="noopener">
                        <Icon name="github" size={15} /> Source code
                      </a>
                    )}
                  </dd>
                </div>
              )
            }
          </dl>
        </aside>
      </div>

      <nav class="project-next" aria-label="More projects">
        <a href="/projects/"><Icon name="arrow-left" size={18} />All projects</a>
        {
          next.id !== project.id && (
            <a href={next.page}>
              Next: {next.data.title}
              <Icon name="arrow-right" size={18} />
            </a>
          )
        }
      </nav>
    </div>
  </article>
</BaseLayout>

<style>
  .project-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .project-layout {
    padding-bottom: clamp(4rem, 8vw, 6rem);
  }

  .project-figure {
    margin: 0;
  }

  .project-figure :global(.project-figure-cover) {
    aspect-ratio: 21 / 9;
    border-radius: var(--radius-lg);
  }

  .project-columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 20rem);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  .project-facts {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
    padding: 1.4rem 1.5rem;
  }

  .project-facts dl {
    display: grid;
    gap: 1.15rem;
    margin: 0;
  }

  .project-facts dt {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .project-facts dd {
    margin: 0.35rem 0 0;
    font-weight: 600;
  }

  .project-links {
    display: grid;
    gap: 0.35rem;
  }

  .project-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
  }

  .project-links a:hover {
    color: var(--accent-text);
  }

  .project-next {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }

  .project-next a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
    text-decoration: none;
  }

  .project-next a:hover {
    color: var(--accent-text);
  }

  @media (max-width: 860px) {
    .project-columns {
      grid-template-columns: minmax(0, 1fr);
    }

    .project-facts {
      position: static;
      grid-row: 1;
    }
  }
</style>
